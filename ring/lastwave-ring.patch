+package com.lastwave.app.ui.player
+
+import android.Manifest
+import android.content.pm.PackageManager
+import android.media.audiofx.Visualizer
+import android.os.SystemClock
+import androidx.compose.foundation.Canvas
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableLongStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.StrokeCap
+import androidx.compose.ui.graphics.drawscope.Stroke
+import androidx.compose.ui.platform.LocalContext
+import androidx.core.content.ContextCompat
+import com.lastwave.app.playback.rhythm.FluidRhythmEngine
+import kotlin.math.PI
+import kotlin.math.cos
+import kotlin.math.hypot
+import kotlin.math.min
+import kotlin.math.pow
+import kotlin.math.sin
+
+/**
+ * Neon-ring equalizer (COLD LOGIC style) for the full player.
+ *
+ * Self-contained: nothing else in LastWave needs to change except the two hooks described in
+ * the patch (session id publish + one call). The ring is fed by the *real* audio of the player
+ * through an [android.media.audiofx.Visualizer] attached to ExoPlayer's audio session, so it
+ * follows the exact sound, not the microphone.
+ *
+ * Needs the RECORD_AUDIO runtime permission (already declared in the manifest and already asked
+ * for by music recognition). Without it, or if the Visualizer cannot be created, the ring falls
+ * back to the beat value of [FluidRhythmEngine] and finally to a gentle idle shimmer.
+ */
+object RingAudioSession {
+    /** Latest ExoPlayer audio session id. Written by MusicPlayer, read by [RingVisualizer]. */
+    @Volatile
+    var id: Int = 0
+}
+
+private const val BANDS = 64          // spectrum resolution
+private const val SPIKES = 168        // spikes drawn around the ring
+
+/** Reads FFT from the player session and turns it into [BANDS] smoothed 0..1 values. */
+private class RingSpectrum {
+    val bands = FloatArray(BANDS)
+    private val target = FloatArray(BANDS)
+    private var visualizer: Visualizer? = null
+    private var peak = 40f
+    @Volatile var live = false
+    @Volatile private var lastFftAt = 0L
+
+    fun start(sessionId: Int): Boolean {
+        stop()
+        if (sessionId <= 0) return false
+        return runCatching {
+            val v = Visualizer(sessionId)
+            val range = Visualizer.getCaptureSizeRange()
+            v.captureSize = 512.coerceIn(range[0], range[1])
+            v.setDataCaptureListener(object : Visualizer.OnDataCaptureListener {
+                override fun onWaveFormDataCapture(v: Visualizer?, waveform: ByteArray?, samplingRate: Int) {}
+                override fun onFftDataCapture(v: Visualizer?, fft: ByteArray?, samplingRate: Int) {
+                    if (fft != null) consume(fft)
+                }
+            }, Visualizer.getMaxCaptureRate() / 2, false, true)
+            v.enabled = true
+            visualizer = v
+            true
+        }.getOrDefault(false)
+    }
+
+    fun stop() {
+        runCatching { visualizer?.enabled = false; visualizer?.release() }
+        visualizer = null
+        live = false
+    }
+
+    private fun consume(fft: ByteArray) {
+        // fft layout: [DC, Nyquist, re1, im1, re2, im2, ...]
+        val bins = fft.size / 2 - 1
+        if (bins < 8) return
+        var frameMax = 0f
+        for (b in 0 until BANDS) {
+            // log-spaced: low bands get few bins, high bands many
+            val lo = (1 + (bins - 1) * (b.toFloat() / BANDS).pow(2.1f)).toInt().coerceIn(1, bins)
+            val hi = (1 + (bins - 1) * ((b + 1f) / BANDS).pow(2.1f)).toInt().coerceIn(lo, bins)
+            var m = 0f
+            for (k in lo..hi) {
+                val re = fft[2 * k].toFloat()
+                val im = fft[2 * k + 1].toFloat()
+                m = maxOf(m, hypot(re, im))
+            }
+            target[b] = m
+            if (m > frameMax) frameMax = m
+        }
+        // automatic gain: follows loud passages quickly, quiet ones slowly
+        peak = maxOf(frameMax, peak * 0.995f).coerceAtLeast(24f)
+        for (b in 0 until BANDS) target[b] = (target[b] / peak).coerceIn(0f, 1f)
+        lastFftAt = SystemClock.uptimeMillis()
+        live = frameMax > 3f
+    }
+
+    /** Called every frame: eases [bands] toward the latest FFT (fast attack, slow release). */
+    fun step(dt: Float, fallbackBeat: Float, timeSec: Float) {
+        val fresh = SystemClock.uptimeMillis() - lastFftAt < 300L && live
+        for (b in 0 until BANDS) {
+            val t = if (fresh) {
+                target[b]
+            } else {
+                // beat-driven fallback (bass bands react most), plus idle shimmer
+                val w = 1f - b / BANDS.toFloat()
+                (fallbackBeat * (0.25f + 0.75f * w) * (0.6f + 0.4f * sin(timeSec * 3f + b * 0.7f)))
+                    .coerceIn(0f, 1f) * 0.9f + 0.06f + 0.03f * sin(timeSec * 1.7f + b)
+            }
+            val k = if (t > bands[b]) 1f - 0.0004f.pow(dt) else 1f - 0.05f.pow(dt)
+            bands[b] += (t - bands[b]) * k
+        }
+    }
+}
+
+@Composable
+fun RingVisualizer(
+    isPlaying: Boolean,
+    modifier: Modifier = Modifier,
+    sessionId: Int = RingAudioSession.id,
+) {
+    val context = LocalContext.current
+    val spectrum = remember { RingSpectrum() }
+    var tick by remember { mutableLongStateOf(0L) }
+
+    DisposableEffect(sessionId, isPlaying) {
+        val allowed = ContextCompat.checkSelfPermission(context, Manifest.permission.RECORD_AUDIO) ==
+            PackageManager.PERMISSION_GRANTED
+        if (isPlaying && allowed) spectrum.start(sessionId)
+        onDispose { spectrum.stop() }
+    }
+
+    LaunchedEffect(isPlaying) {
+        var last = 0L
+        val t0 = System.nanoTime()
+        while (true) {
+            androidx.compose.runtime.withFrameNanos { now ->
+                val dt = if (last == 0L) 0.016f else ((now - last) / 1e9f).coerceIn(0.001f, 0.05f)
+                last = now
+                val beat = if (isPlaying) FluidRhythmEngine.currentRhythmValue else 0f
+                spectrum.step(dt, beat, (System.nanoTime() - t0) / 1e9f)
+                tick = now
+            }
+            // paused and settled: stop redrawing until playback resumes
+            if (!isPlaying && spectrum.bands.max() < 0.15f) kotlinx.coroutines.delay(400)
+        }
+    }
+
+    Canvas(modifier) {
+        @Suppress("UNUSED_VARIABLE") val observe = tick        // redraw every frame
+        val c = Offset(size.width / 2f, size.height / 2f)
+        val base = min(size.width, size.height)
+        val r = base * 0.27f                                   // ring radius
+        val maxLen = base * 0.17f                              // longest spike
+        val tau = (2.0 * PI).toFloat()
+        val rot = (SystemClock.uptimeMillis() % 60000L) / 60000f * tau
+
+        // faint base ring
+        drawCircle(Color.White.copy(alpha = 0.10f), radius = r, center = c, style = Stroke(base * 0.004f))
+
+        for (i in 0 until SPIKES) {
+            val u = i / SPIKES.toFloat()
+            // mirror the spectrum around the ring so left/right halves match
+            val m = if (u < 0.5f) u * 2f else (1f - u) * 2f
+            val v = spectrum.bands[(m * (BANDS - 1)).toInt().coerceIn(0, BANDS - 1)]
+            val len = base * 0.012f + maxLen * v
+            val a = u * tau + rot
+            val ca = cos(a); val sa = sin(a)
+            val p0 = Offset(c.x + ca * r, c.y + sa * r)
+            val p1 = Offset(c.x + ca * (r + len), c.y + sa * (r + len))
+            val color = Color.hsv((u * 360f + 200f) % 360f, 0.85f, 1f)
+            drawLine(color.copy(alpha = 0.22f), p0, p1, strokeWidth = base * 0.013f, cap = StrokeCap.Round)   // glow
+            drawLine(color.copy(alpha = 0.55f + 0.45f * v), p0, p1, strokeWidth = base * 0.0055f, cap = StrokeCap.Round)
+        }
+    }
+}
